{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-shell",
  "version": "0.1.6",
  "identifier": "com.workspace.dshshell",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DSH-View (unofficial)",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "additionalBrowserArgs": "--no-proxy-server"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}